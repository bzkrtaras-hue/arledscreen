# Self-hosted price calculator (embedded same-origin on /<locale>/hesaplayici/).
# Voice input (Web Speech API) needs the microphone: allowed for this origin only,
# both on the calculator document and on the pages that embed it (iframe allow="microphone").
/fiyat-hesap/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  Cache-Control: public, max-age=0, must-revalidate

/tr/hesaplayici/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

/en/hesaplayici/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

/ar/hesaplayici/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

/ru/hesaplayici/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

# Canlı Destek widget (TR/EN homepages) embeds /fiyat-hesap/?mode=chat with allow="microphone";
# voice input needs the microphone for this origin only. Rest of the CSP unchanged.
/tr/
