# ARLEDSCREEN static export - Apache / LiteSpeed (Hostinger) config
# Mirrors public/_headers + public/_redirects (Cloudflare Pages) for Apache/LiteSpeed.
# NOT shipped in the Cloudflare Pages build (kept out of public/ on 2026-10-04).
# Only for a Hostinger fallback: copy this file into the web root next to index.html.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Security headers (same as public/_headers, plus HSTS)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' mailto: https://wa.me https://api.whatsapp.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https:; frame-src 'self' https://fiyat.arledscreen.com; manifest-src 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# Cache rules (path-based via SetEnvIf; later matches win)
#   HTML / RSC payloads (.txt) / directory URLs : no long cache (revalidate)
#   images & fonts                              : 30 days (not content-hashed)
#   /_next/static/* (content-hashed)            : 1 year, immutable
#   sitemap.xml / robots.txt / llms.txt         : 1 hour
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "(/|\.html?|\.txt)$" CACHE_HTML
  SetEnvIf Request_URI "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|mp4|webm)$" CACHE_MEDIA
  SetEnvIf Request_URI "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|mp4|webm)$" !CACHE_HTML
  SetEnvIf Request_URI "^/(sitemap\.xml|robots\.txt|llms\.txt)$" CACHE_SHORT
  SetEnvIf Request_URI "^/(sitemap\.xml|robots\.txt|llms\.txt)$" !CACHE_HTML
  SetEnvIf Request_URI "^/_next/static/" CACHE_IMMUTABLE
  SetEnvIf Request_URI "^/_next/static/" !CACHE_HTML
  SetEnvIf Request_URI "^/_next/static/" !CACHE_MEDIA
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=0, must-revalidate" env=CACHE_HTML
  Header set Cache-Control "public, max-age=0, must-revalidate" env=REDIRECT_CACHE_HTML
  Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" env=CACHE_MEDIA
  Header set Cache-Control "public, max-age=3600" env=CACHE_SHORT
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE
</IfModule>

# ---------------------------------------------------------------------------
# Compression (LiteSpeed compresses natively; these apply on Apache)
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType image/webp .webp
  AddType text/plain .txt
  AddCharset utf-8 .html .txt .xml .js .css .json
</IfModule>

RewriteEngine On

# www -> apex (301). Root path goes straight to /tr/ to avoid www→/→/tr/ hop.
# Only when Host starts with "www."; the target host has no "www." so this
# cannot loop. Always redirects to HTTPS.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^$ https://%1/tr/ [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# Apex / -> absolute TR home (Turkish canonical) — permanent server redirect.
# Absolute target avoids a relative Location that search engines may re-resolve
# against a stale cached root document.
RewriteRule ^$ https://arledscreen.com/tr/ [R=301,L,NE]
RewriteRule ^index\.html?$ https://arledscreen.com/tr/ [R=301,L,NE]

# Legacy Horizons / old-site paths -> current routes (mirrors public/_redirects for Apache/LiteSpeed hosting)
RewriteRule ^(iletisim|teklif-al|contact)(\.html)?/?$ /tr/quote/ [R=301,L]
RewriteRule ^(hizmetler|services|servicedetail|destek-merkezi)(\.html)?/?$ /tr/hizmetler/ [R=301,L]
RewriteRule ^urunler/(ic-mekan-led-ekran|dis-mekan-led-ekran|gob-led-ekran|kiralik-led-ekran|esnek-led-ekran)/?$ /tr/products/$1/ [R=301,L]
RewriteRule ^urunler/(seffaf-led-ekran|ince-pitch-led-ekran|poster-led-ekran|led-modul-ve-kontrol-sistemleri)/?$ /tr/products/$1/ [R=301,L]
RewriteRule ^urunler/transparan-led-ekran/?$ /tr/products/seffaf-led-ekran/ [R=301,L]
RewriteRule ^urunler/rental-led-ekran/?$ /tr/products/kiralik-led-ekran/ [R=301,L]
RewriteRule ^urunler/oem-urunler/?$ /tr/products/led-modul-ve-kontrol-sistemleri/ [R=301,L]
RewriteRule ^urunler/(ic-mekan|dis-mekan|gob|kiralik|esnek)-led/?$ /tr/products/$1-led-ekran/ [R=301,L]
RewriteRule ^urunler/led-modul-yedek-parca-servis/?$ /tr/hizmetler/ [R=301,L]
RewriteRule ^urunler(/.*)?$ /tr/products/ [R=301,L]
RewriteRule ^(ic-mekan-led-ekranlar|icmekanled)/?$ /tr/products/ic-mekan-led-ekran/ [R=301,L]
RewriteRule ^(dis-mekan-led-ekranlar|dismekanled)/?$ /tr/products/dis-mekan-led-ekran/ [R=301,L]
RewriteRule ^(kiralik-led-ekranlar|kiralikled)/?$ /tr/products/kiralik-led-ekran/ [R=301,L]
RewriteRule ^gobleddetail/?$ /tr/products/gob-led-ekran/ [R=301,L]
RewriteRule ^esnekleddetail/?$ /tr/products/esnek-led-ekran/ [R=301,L]
RewriteRule ^(projelerimiz|referanslar|tamamlanan-projeler|galeri|projects)/?$ /tr/projelerimiz/ [R=301,L]
RewriteRule ^(hakkimizda|about|sertifikalar|kullanim-kosullari)/?$ /tr/about/ [R=301,L]
RewriteRule ^blog(/.*)?$ /tr/rehber/ [R=301,L]
RewriteRule ^(blogarticle|blogdetail)/?$ /tr/rehber/ [R=301,L]
RewriteRule ^sss/?$ /tr/sss/ [R=301,L]
RewriteRule ^ai/?$ /tr/yapay-zeka/ [R=301,L]
RewriteRule ^(fiyat-listesi|hesaplayici)/?$ /tr/hesaplayici/ [R=301,L]
RewriteRule ^tools/?$ /tr/hesaplayici/ [R=301,L]
RewriteRule ^((tr|en|ar|ru)/)?configurator/?$ /tr/hesaplayici/ [R=301,L]
RewriteRule ^home/?$ /tr/ [R=301,L]

# Leave real files and directories alone (_next, assets, existing HTML)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Do not rewrite paths that already have a locale prefix
RewriteRule ^(tr|en|ar|ru)(/|$) - [L]

# Bare single-segment paths (e.g. /products) -> /tr/products/
RewriteRule ^([A-Za-z0-9_-]+)/?$ /tr/$1/ [R=301,L]
